{
  "validate-schema": {
    "PostToolUse": [
      {
        "matcher": "edit_file|write_file|replace_file_content|multi_replace_file_content|write_to_file",
        "hooks": [
          {
            "type": "command",
            "command": "node ./tools/antigravity-schema-hook.mjs",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
